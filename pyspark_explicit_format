from pyspark.sql.functions import col, lit, when, date_format, to_timestamp, coalesce, trim, expr, first
from pyspark.sql.types import StringType
from functools import reduce

def harmonize_dates_pyspark_explicit(df, configs):
    # This function harmonizes date columns using a vectorized unpivot/pivot approach.
    date_cols = [c for c in df.columns if c.upper().endswith("DTC")]
    if not date_cols:
        return df, []

    # 1. Unpivot to long format.
    key_cols = [c for c in df.columns if c not in date_cols]
    stack_args = [f"'{c}', `{c}`" for c in date_cols]
    stack_expr = f"stack({len(date_cols)}, {', '.join(stack_args)}) as (date_col_name, original_value)"
    unpivoted_df = df.selectExpr(*key_cols, stack_expr)

    # 2. Harmonize using a single nested expression.
    harmonized_value_expr = lit(None).cast(StringType())
    for config in reversed(configs):
        input_pattern = config["input_pattern"]
        target_pattern = config["target_iso_pattern"]
        parsed_val = date_format(to_timestamp(col("original_value"), input_pattern), target_pattern)
        harmonized_value_expr = when(parsed_val.isNotNull(), parsed_val).otherwise(harmonized_value_expr)

    is_iso_expr = (to_timestamp(col("original_value"), ISO_DATE_FORMAT_FOR_DATE_ISO8601).isNotNull()) | (coalesce(trim(col("original_value")), lit("")) == "")
    harmonized_long_df = unpivoted_df.withColumn(
        "harmonized_value",
        when(is_iso_expr, col("original_value")).otherwise(harmonized_value_expr)
    )
    
    # 3. Pivot back to wide format.
    pivoted_df = harmonized_long_df.groupBy(*key_cols).pivot("date_col_name", date_cols).agg(
        first("harmonized_value").alias("harmonized_value"),
        first("original_value").alias("original_value")
    )
    
    # 4. Final assembly.
    final_cols_expr = key_cols.copy()
    new_cols = []
    for col_name in date_cols:
        final_cols_expr.append(col(f"`{col_name}`.harmonized_value").alias(col_name))
        original_col_name = f"{col_name}_ORIGINAL_VALUE"
        final_cols_expr.append(col(f"`{col_name}`.original_value").alias(original_col_name))
        new_cols.append(original_col_name)
        
    final_df = pivoted_df.select(final_cols_expr)
    return final_df, new_cols

