package com.yourorg.utils

import java.time.format.{DateTimeFormatter, DateTimeParseException, ResolverStyle, DateTimeFormatterBuilder}
import java.time.temporal.{TemporalAccessor, ChronoField}
import org.apache.spark.sql.SparkSession
import org.apache.spark.broadcast.Broadcast

object UDFLogic {
  // Determines target format string based on a flag.
  private def getTargetFormat(flag: String): String = flag match {
    case "Date_time"  => "yyyy-MM-dd'T'HH:mm:ss"
    case "Date"       => "yyyy-MM-dd"
    case "Year_Month" => "yyyy-MM"
    case "Year"       => "yyyy"
    case _            => "yyyy-MM-dd" // Default
  }
  
  // Parses date string using a flag to determine the target format.
  def parseDateWithFlag(originalDateStr: String, patternConfigs: Seq[(String, String)]): String = {
    if (originalDateStr == null || originalDateStr.trim.isEmpty) return null
    for ((inputPattern, flag) <- patternConfigs) {
      try {
        val parser = new DateTimeFormatterBuilder().appendPattern(inputPattern).parseDefaulting(ChronoField.MONTH_OF_YEAR, 1).toFormatter().withResolverStyle(ResolverStyle.STRICT)
        val temporal = parser.parse(originalDateStr)
        val targetPattern = getTargetFormat(flag)
        return DateTimeFormatter.ofPattern(targetPattern).format(temporal)
      } catch { case _: DateTimeParseException => }
    }
    null
  }
}

object DateHarmonizerRegistration {
  private def convertSparkPatternToJava(p: String): String = { if (p == null) return null; p.replace("yyyy", "uuuu").replace("yy", "uu").replaceAll("S+", "SSS") }
  
  // Registers the UDF that uses flags.
  def registerUDF(spark: SparkSession, viewName: String, udfName: String): Unit = {
    val patterns = spark.table(viewName).select("spark_input_pattern_col", "spark_flag_col").collect().map(r => (convertSparkPatternToJava(r.getString(0)), r.getString(1))).toSeq
    val broadcastedPatterns = spark.sparkContext.broadcast(patterns)
    val udfLambda = (dateStr: String) => UDFLogic.parseDateWithFlag(dateStr, broadcastedPatterns.value)
    spark.udf.register(udfName, udfLambda)
  }
}
